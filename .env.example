# Public, client-safe Supabase configuration only.
# NEVER put a secret key (sb_secret_... / service_role) or the database password here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Settings -> API Keys -> Publishable key (starts with sb_publishable_).
# The legacy "anon" JWT key also works but Supabase deprecates it at the end of 2026.
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key

# Optional: base path used by Vite when deploying to a GitHub Pages sub-path.
# Local development should leave this unset (defaults to "/").
# VITE_BASE_PATH=/farm-hisab/
